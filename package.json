{
  "name": "ez-encrypt",
  "version": "0.0.0",
  "description": "easy call encrypt",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/external/ez-encrypt.umd.cjs",
  "module": "./dist/external/ez-encrypt.es.js",
  "types": "./dist/external/ez-encrypt.d.ts",
  "exports": {
    ".": {
      "types": "./dist/external/ez-encrypt.d.ts",
      "import": "./dist/external/ez-encrypt.es.js",
      "require": "./dist/external/ez-encrypt.umd.cjs"
    },
    "./bundle": {
      "types": "./dist/bundle/ez-encrypt.d.ts",
      "import": "./dist/bundle/ez-encrypt.es.js",
      "require": "./dist/bundle/ez-encrypt.umd.cjs"
    }
  },
  "scripts": {
    "build": "npm run build:external && npm run build:bundle",
    "build:external": "vite build",
    "build:bundle": "vite build --config vite.bundle.config.ts",

    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hgnim/ez-encrypt.git"
  },
  "keywords": [],
  "author": "Hgnim",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Hgnim/ez-encrypt/issues"
  },
  "homepage": "https://github.com/Hgnim/ez-encrypt#readme",
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2"
  },
  "dependencies": {
    "crypto-js": "^4.2.0"
  }
}
